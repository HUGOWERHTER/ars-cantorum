---
import Layout from '../layouts/Layout.astro';

const postModules = import.meta.glob('../content/articulos/*.md', { eager: true });
const articulos = Object.entries(postModules).map(([path, mod]: [string, any]) => {
	const filename = path.split(/[\\/]/).pop()?.replace('.md', '');
	return {
		slug: filename,
		title: mod.frontmatter?.title || "Artículo sin título",
		description: mod.frontmatter?.description || "Ensayo de investigación vocal.",
		date: mod.frontmatter?.date || "2026",
		category: mod.frontmatter?.category || "Técnica Vocal",
		tags: mod.frontmatter?.tags || ["Bel Canto"],
		readTime: mod.frontmatter?.readTime || "5 min"
	};
});
---

<Layout>
	<div class="container">
		<!-- Hero Section -->
		<section style="text-align: center; padding: 2.5rem 0 3.5rem; margin-bottom: 2.5rem; border-bottom: 1px solid var(--border-color);">
			<h1 style="font-size: 2.7rem; font-weight: 700; margin-bottom: 1rem; color: #0f172a; line-height: 1.2;">
				Estudios sobre la Voz y el Canto Lírico
			</h1>
			<p style="font-size: 1.25rem; color: #475569; max-width: 650px; margin: 0 auto; line-height: 1.6;">
				Ensayos sobre la tradición del Bel Canto, pedagogía vocal comparada y acústica musical.
			</p>
		</section>

		<!-- Lista de Artículos -->
		<section>
			<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 2rem;">
				<h2 style="font-size: 1.6rem; color: #0f172a;">Ensayos Publicados</h2>
				<span class="font-sans" style="font-size: 0.85rem; color: #64748b;">
					{articulos.length} {articulos.length === 1 ? 'artículo' : 'artículos'}
				</span>
			</div>

			<div style="display: flex; flex-direction: column; gap: 2rem;">
				{articulos.map(art => (
					<article style="background: #ffffff; border: 1px solid var(--border-color); border-radius: 8px; padding: 2.2rem; box-shadow: 0 1px 4px rgba(0,0,0,0.03);">
						<div class="font-sans" style="display: flex; gap: 0.75rem; align-items: center; margin-bottom: 0.8rem;">
							<span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; background: #f4ede3; color: var(--accent-gold); padding: 0.2rem 0.6rem; border-radius: 4px;">
								{art.category}
							</span>
							<span style="font-size: 0.8rem; color: #cbd5e1;">•</span>
							<span style="font-size: 0.85rem; color: #64748b;">Lectura: {art.readTime}</span>
						</div>

						<h3 style="font-size: 1.65rem; margin-bottom: 0.8rem; line-height: 1.3;">
							<a href={`/articulos/${art.slug}`} style="color: #0f172a; text-decoration: none;">
								{art.title}
							</a>
						</h3>

						<p style="color: #475569; font-size: 1.1rem; line-height: 1.6; margin-bottom: 1.5rem;">
							{art.description}
						</p>

						<div class="font-sans" style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #f1f5f9; padding-top: 1rem;">
							<div style="display: flex; gap: 0.4rem; flex-wrap: wrap;">
								{art.tags.map((tag: string) => (
									<span style="font-size: 0.75rem; color: #64748b; background: #f8fafc; border: 1px solid #e2e8f0; padding: 0.15rem 0.5rem; border-radius: 4px;">
										{tag}
									</span>
								))}
							</div>
							
							<a href={`/articulos/${art.slug}`} class="font-sans" style="font-size: 0.9rem; font-weight: 600; color: var(--accent); display: flex; align-items: center; gap: 0.25rem;">
								Leer Ensayo →
							</a>
						</div>
					</article>
				))}
			</div>
		</section>
	</div>
</Layout>
