---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const postModules = import.meta.glob('../../content/articulos/*.md', { eager: true });
	return Object.entries(postModules).map(([path, post]: [string, any]) => {
		const slug = path.split(/[\\/]/).pop()?.replace('.md', '');
		return {
			params: { slug },
			props: { post },
		};
	});
}

const { post } = Astro.props;
const { Content } = post;
const { title, date, category, readTime } = post.frontmatter;

const schemaData = {
	"@context": "https://schema.org",
	"@type": "ScholarlyArticle",
	"headline": title,
	"description": post.frontmatter.description,
	"author": {
		"@type": "Organization",
		"name": "Ars Cantorum",
		"url": "https://www.arscantorum.com"
	},
	"publisher": {
		"@type": "Organization",
		"name": "Ars Cantorum — El Arte del Canto",
		"logo": {
			"@type": "ImageObject",
			"url": "https://www.arscantorum.com/logo.jpg"
		}
	},
	"datePublished": date,
	"inLanguage": "es",
	"mainEntityOfPage": `https://www.arscantorum.com/articulos/${Astro.params.slug}/`
};
---

<Layout title={`${title} — Ars Cantorum`} description={post.frontmatter.description}>
	<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
	<div class="container" style="max-width: 800px;">
		<!-- Barra superior con botón volver -->
		<div class="font-sans" style="margin-bottom: 2.5rem;">
			<a href="/" style="display: inline-flex; align-items: center; gap: 0.4rem; color: #64748b; font-size: 0.9rem; font-weight: 500; text-decoration: none;">
				← Volver al índice de artículos
			</a>
		</div>

		<!-- Cabecera del Artículo -->
		<header style="margin-bottom: 3.5rem; padding-bottom: 2rem; border-bottom: 1px solid var(--border-color);">
			<div class="font-sans" style="display: flex; gap: 0.75rem; align-items: center; margin-bottom: 1.2rem; flex-wrap: wrap;">
				<span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; background: #f4ede3; color: var(--accent-gold); padding: 0.25rem 0.7rem; border-radius: 4px;">
					{category || "Técnica Vocal"}
				</span>
				<span style="font-size: 0.85rem; color: #cbd5e1;">•</span>
				<span style="font-size: 0.9rem; color: #64748b;">Lectura: {readTime || "7 min"}</span>
			</div>

			<h1 style="font-size: 2.6rem; color: #0f172a; margin-bottom: 1.2rem; line-height: 1.2;">
				{title}
			</h1>

			{post.frontmatter.description && (
				<p style="font-size: 1.25rem; color: #475569; line-height: 1.6; font-style: italic;">
					{post.frontmatter.description}
				</p>
			)}
		</header>

		<!-- Cuerpo del Artículo -->
		<article class="articulo-contenido" style="font-size: 1.2rem; line-height: 1.85; color: #1e293b;">
			<Content />
		</article>

		<!-- Módulo Editorial: Debate Académico, Consultas y Correspondencia -->
		<section style="margin-top: 4rem; padding: 2.2rem 2.5rem; background: #ffffff; border: 1px solid var(--border-color); border-radius: 8px; box-shadow: 0 4px 20px rgba(15, 23, 42, 0.04);">
			<div class="font-sans" style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.75rem;">
				<span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; background: #f4ede3; color: var(--accent-gold); padding: 0.2rem 0.6rem; border-radius: 4px;">
					Coloquio Editorial
				</span>
				<span style="font-size: 0.85rem; color: #94a3b8;">• Ars Cantorum</span>
			</div>

			<h3 class="font-heading" style="font-size: 1.45rem; color: #0f172a; margin-bottom: 0.75rem;">
				Tribuna de Debate Académico y Correspondencia
			</h3>

			<p style="font-size: 1.1rem; color: #475569; line-height: 1.7; margin-bottom: 1.6rem; font-style: italic;">
				«En Ars Cantorum concebimos la pedagogía vocal y la investigación musicológica como un diálogo riguroso y vivo. ¿Tiene alguna observación crítica sobre este ensayo, desea consultar pasajes de los tratados canónicos o compartir experiencias de su práctica en el aula o el escenario?»
			</p>

			<div class="font-sans" style="display: flex; gap: 1.2rem; flex-wrap: wrap; align-items: center; justify-content: space-between; border-top: 1px solid #f1f5f9; padding-top: 1.4rem;">
				<a href={`mailto:contacto@arscantorum.com?subject=Consulta sobre: ${encodeURIComponent(title)}`} 
				   style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--accent); color: #ffffff; padding: 0.7rem 1.4rem; border-radius: 6px; font-weight: 600; font-size: 0.95rem; text-decoration: none; box-shadow: 0 2px 8px rgba(136, 19, 55, 0.2);">
					✉ Escribir a la Redacción
				</a>

				<div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
					<span style="font-size: 0.85rem; color: #64748b; font-weight: 600;">Participar en redes:</span>
					<a href="https://www.instagram.com/arscantorum" target="_blank" rel="noopener noreferrer" style="color: #475569; font-size: 0.85rem; font-weight: 600; text-decoration: none; border: 1px solid #e2e8f0; padding: 0.4rem 0.8rem; border-radius: 4px; background: #f8fafc; transition: all 0.2s ease;">Instagram</a>
					<a href="https://www.youtube.com/@arscantorum" target="_blank" rel="noopener noreferrer" style="color: #475569; font-size: 0.85rem; font-weight: 600; text-decoration: none; border: 1px solid #e2e8f0; padding: 0.4rem 0.8rem; border-radius: 4px; background: #f8fafc; transition: all 0.2s ease;">YouTube</a>
					<a href="https://www.facebook.com/share/1LWBuePZJt/" target="_blank" rel="noopener noreferrer" style="color: #475569; font-size: 0.85rem; font-weight: 600; text-decoration: none; border: 1px solid #e2e8f0; padding: 0.4rem 0.8rem; border-radius: 4px; background: #f8fafc; transition: all 0.2s ease;">Facebook</a>
				</div>
			</div>
		</section>

		<!-- Pie de Artículo -->
		<div class="font-sans" style="margin-top: 4.5rem; padding-top: 2rem; border-top: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
			<a href="/" style="color: var(--accent); font-weight: 600; text-decoration: none;">
				← Volver a todos los artículos
			</a>
			<span style="color: #94a3b8; font-size: 0.85rem;">
				Ars Cantorum
			</span>
		</div>
	</div>
</Layout>

<style is:global>
	.articulo-contenido h2 {
		font-size: 1.8rem;
		margin-top: 3rem;
		margin-bottom: 1rem;
		color: #0f172a;
		border-bottom: 1px solid #f1f5f9;
		padding-bottom: 0.4rem;
	}

	.articulo-contenido h3 {
		font-size: 1.35rem;
		margin-top: 2.2rem;
		margin-bottom: 0.75rem;
		color: #334155;
	}

	.articulo-contenido p {
		margin-bottom: 1.5rem;
	}

	.articulo-contenido ul, .articulo-contenido ol {
		margin: 1.2rem 0 1.6rem 1.8rem;
	}

	.articulo-contenido li {
		margin-bottom: 0.5rem;
	}

	.articulo-contenido hr {
		border: 0;
		height: 1px;
		background: var(--border-color);
		margin: 2.5rem 0;
	}

	.articulo-contenido p:has(img) {
		text-align: center;
		margin: 2.5rem 0;
	}

	.articulo-contenido img,
	.articulo-contenido svg {
		display: block;
		margin: 2.5rem auto;
		max-width: 100%;
		height: auto;
		border-radius: 6px;
		box-shadow: 0 4px 20px rgba(15, 23, 42, 0.08);
	}
</style>
