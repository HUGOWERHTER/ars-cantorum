---
import Layout from '../../layouts/Layout.astro';
import { formatearFecha } from '../../utils/fechas';
import { calcularTiempoLectura } from '../../utils/lectura';

export async function getStaticPaths() {
	const today = new Date().toISOString().slice(0, 10);
	const postModules = import.meta.glob('../../content/articulos/*.md', { eager: true });
	return Object.entries(postModules)
		.filter(([, post]: [string, any]) => (post.frontmatter?.date || '2026-11-01') <= today)
		.map(([path, post]: [string, any]) => {
			const slug = path.split(/[\\/]/).pop()?.replace('.md', '');
			return {
				params: { slug },
				props: { post },
			};
		});
}

const { post } = Astro.props;
const { Content } = post;
const { title, date, category, tags = [] } = post.frontmatter;
const readTime = calcularTiempoLectura(
	typeof post.rawContent === 'function' ? post.rawContent() : '',
	post.frontmatter?.readTime || '5 min'
);

// Identidad editorial del proyecto independiente (Opción B)
const authorName = post.frontmatter?.authorName || 'Ars Cantorum';
const authorSubtitle = post.frontmatter?.authorSubtitle || 'Investigación vocal independiente y pedagogía del Bel Canto';

// Cargar todos los artículos publicados para calcular los 3 más relacionados temáticamente
const today = new Date().toISOString().slice(0, 10);
const postModules = import.meta.glob('../../content/articulos/*.md', { eager: true });
const currentSlug = Astro.params.slug;

const otrosArticulos = Object.entries(postModules)
	.map(([path, mod]: [string, any]) => {
		const slug = path.split(/[\\/]/).pop()?.replace('.md', '');
		return {
			slug,
			title: mod.frontmatter?.title || "Artículo",
			description: mod.frontmatter?.description || "",
			date: mod.frontmatter?.date || "2026-11-01",
			category: mod.frontmatter?.category || "Biomecánica y Técnica",
			tags: mod.frontmatter?.tags || [],
			readTime: calcularTiempoLectura(typeof mod.rawContent === 'function' ? mod.rawContent() : '', mod.frontmatter?.readTime || "5 min")
		};
	})
	.filter(art => art.slug !== currentSlug && art.date <= today);

// Algoritmo de afinidad: +5 puntos por misma categoría, +2 puntos por cada etiqueta compartida
otrosArticulos.forEach((art: any) => {
	let score = 0;
	if (art.category && art.category === category) {
		score += 5;
	}
	const shared = art.tags.filter((t: string) => tags.includes(t));
	score += shared.length * 2;
	art.score = score;
});

// Ordenar por score descendente, y en caso de empate por fecha más reciente
otrosArticulos.sort((a: any, b: any) => {
	if (b.score !== a.score) return b.score - a.score;
	return new Date(b.date).getTime() - new Date(a.date).getTime();
});

const articulosRelacionados = otrosArticulos.slice(0, 3);

const schemaData = {
	"@context": "https://schema.org",
	"@type": "ScholarlyArticle",
	"headline": title,
	"description": post.frontmatter.description,
	"author": {
		"@type": "Organization",
		"name": "Ars Cantorum",
		"url": "https://www.arscantorum.com"
	},
	"publisher": {
		"@type": "Organization",
		"name": "Ars Cantorum — El Arte del Canto",
		"logo": {
			"@type": "ImageObject",
			"url": "https://www.arscantorum.com/logo.jpg"
		}
	},
	"datePublished": date,
	"inLanguage": "es",
	"mainEntityOfPage": `https://www.arscantorum.com/articulos/${Astro.params.slug}/`
};
---

<Layout title={`${title} — Ars Cantorum`} description={post.frontmatter.description} ogType="article">
	<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
	<div class="container" style="max-width: 800px;">
		<!-- Barra superior con botón volver -->
		<div class="font-sans" style="margin-bottom: 2.5rem;">
			<a href="/" style="display: inline-flex; align-items: center; gap: 0.4rem; color: #64748b; font-size: 0.9rem; font-weight: 500; text-decoration: none;">
				← Volver al índice de artículos
			</a>
		</div>

		<!-- Cabecera del Artículo -->
		<header style="margin-bottom: 3.5rem; padding-bottom: 2rem; border-bottom: 1px solid var(--border-color);">
			<div class="font-sans" style="display: flex; gap: 0.75rem; align-items: center; margin-bottom: 1.2rem; flex-wrap: wrap;">
				<span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; background: #f4ede3; color: var(--accent-gold); padding: 0.25rem 0.7rem; border-radius: 4px;">
					{category || "Técnica Vocal"}
				</span>
				<span style="font-size: 0.85rem; color: #cbd5e1;">•</span>
				<span style="font-size: 0.9rem; color: #64748b;">Lectura: {readTime || "7 min"}</span>
				{date && (
					<>
						<span style="font-size: 0.85rem; color: #cbd5e1;">•</span>
						<span style="font-size: 0.9rem; color: #64748b;">{formatearFecha(date)}</span>
					</>
				)}

				<!-- Insignia en cabecera si ya fue leído previamente -->
				<span id="badge-cabecera-leido" style="display: none; align-items: center; gap: 0.35rem; font-size: 0.75rem; font-weight: 700; color: #166534; background: #f0fdf4; border: 1px solid #bbf7d0; padding: 0.2rem 0.65rem; border-radius: 12px; margin-left: auto;">
					<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
					Ensayo Leído
				</span>
			</div>

			<h1 style="font-size: 2.6rem; color: #0f172a; margin-bottom: 1.2rem; line-height: 1.2;">
				{title}
			</h1>

			{post.frontmatter.description && (
				<p style="font-size: 1.25rem; color: #475569; line-height: 1.6; font-style: italic;">
					{post.frontmatter.description}
				</p>
			)}
		</header>

		<!-- Cuerpo del Artículo -->
		<article class="articulo-contenido" style="font-size: 1.2rem; line-height: 1.85; color: #1e293b;">
			<Content />
		</article>

		<!-- Marcador centinela invisible para detectar cuando se lee hasta el final -->
		<div id="fin-articulo-centinela" style="height: 1px; margin: 1.5rem 0;" aria-hidden="true"></div>

		<!-- ==================== BANNER DE LECTURA COMPLETADA (PERSISTENTE) ==================== -->
		<div id="modulo-lectura-completada" class="font-sans" style="margin-top: 3rem; padding: 1.4rem 1.6rem; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.03); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
			<div style="display: flex; align-items: center; gap: 0.9rem;">
				<div id="icono-estado-lectura" style="width: 38px; height: 38px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #f1f5f9; color: #64748b; font-size: 1.15rem; flex-shrink: 0; transition: all 0.25s ease;">
					📖
				</div>
				<div>
					<div id="texto-estado-lectura" style="font-weight: 700; font-size: 0.95rem; color: #0f172a;">
						Lectura en curso
					</div>
					<div id="subtexto-estado-lectura" style="font-size: 0.82rem; color: #64748b;">
						Al llegar al final del ensayo, se registrará automáticamente como leído en tu biblioteca.
					</div>
				</div>
			</div>
			
			<button id="btn-toggle-leido" type="button" style="background: #f0fdf4; border: 1px solid #bbf7d0; color: #15803d; padding: 0.45rem 0.95rem; border-radius: 6px; font-size: 0.85rem; font-weight: 600; cursor: pointer; transition: all 0.2s; display: inline-flex; align-items: center; gap: 0.35rem;">
				Marcar como leído
			</button>
		</div>

		<!-- ==================== FIRMA EDITORIAL (E-E-A-T) ==================== -->
		<aside class="font-sans" style="margin-top: 2rem; padding: 1.4rem 1.6rem; background: #faf8f5; border: 1px solid var(--border-color); border-radius: 8px; display: flex; align-items: center; gap: 1.15rem; flex-wrap: wrap;">
			<img src="/logo.jpg" alt={authorName} style="width: 58px; height: 58px; border-radius: 50%; object-fit: cover; border: 1.5px solid #b45309; flex-shrink: 0;" />
			<div style="flex: 1; min-width: 220px;">
				<div style="font-weight: 700; font-size: 0.98rem; color: #0f172a; margin-bottom: 0.1rem;">
					{authorName}
				</div>
				<div style="font-size: 0.82rem; font-weight: 600; color: var(--accent-gold); margin-bottom: 0.35rem;">
					{authorSubtitle}
				</div>
				<p style="font-size: 0.85rem; color: #475569; line-height: 1.5; margin: 0;">
					Proyecto filantrópico dedicado al contraste entre fuentes históricas del Bel Canto y acústica vocal contemporánea.
					<a href="/sobre" style="font-weight: 600; margin-left: 0.35rem;">Sobre el proyecto y criterio editorial →</a>
				</p>
			</div>
		</aside>

		<!-- ==================== ARTÍCULOS RELACIONADOS ==================== -->
		{articulosRelacionados.length > 0 && (
			<section style="margin-top: 4.5rem; padding-top: 2.5rem; border-top: 1px solid var(--border-color);">
				<div style="margin-bottom: 1.8rem;">
					<div class="font-sans" style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; background: #f4ede3; color: var(--accent-gold); display: inline-block; padding: 0.2rem 0.6rem; border-radius: 4px; margin-bottom: 0.5rem;">
						Continuar la investigación
					</div>
					<h3 style="font-size: 1.65rem; color: #0f172a; margin-bottom: 0.35rem;">
						Ensayos relacionados
					</h3>
					<p class="font-sans" style="font-size: 0.95rem; color: #64748b;">
						Estudios vinculados por afinidad fisiológica, fuentes históricas y técnica vocal.
					</p>
				</div>

				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; align-items: stretch;">
					{articulosRelacionados.map((rel: any) => (
						<article data-article-card data-slug={rel.slug} style="height: 100%; background: #ffffff; border: 1px solid var(--border-color); border-radius: 8px; padding: 1.5rem; display: flex; flex-direction: column; justify-content: space-between; box-shadow: 0 1px 4px rgba(0,0,0,0.03); transition: border-left 0.2s, box-shadow 0.2s;">
							<div>
								<div class="font-sans" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; gap: 0.5rem; flex-wrap: wrap;">
									<span style="font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--accent-gold);">
										{rel.category}
									</span>
									<span class="badge-leido" style="display: none; align-items: center; gap: 0.25rem; font-size: 0.7rem; font-weight: 700; color: #166534; background: #f0fdf4; border: 1px solid #bbf7d0; padding: 0.1rem 0.45rem; border-radius: 10px;">
										✓ Leído
									</span>
								</div>

								<h4 style="font-size: 1.15rem; line-height: 1.35; margin-bottom: 0.6rem;">
									<a href={`/articulos/${rel.slug}`} style="color: #0f172a; text-decoration: none; display: inline-flex; align-items: baseline;">
										<span class="check-title-leido" style="display: none; color: #16a34a; font-weight: bold; margin-right: 0.3rem;">✓</span>
										<span>{rel.title}</span>
									</a>
								</h4>

								<p style="font-size: 0.95rem; color: #475569; line-height: 1.5; margin-bottom: 1.2rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
									{rel.description}
								</p>
							</div>

							<div class="font-sans" style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #f1f5f9; padding-top: 0.8rem; font-size: 0.8rem; color: #64748b;">
								<span>Lectura: {rel.readTime}</span>
								<a href={`/articulos/${rel.slug}`} style="font-weight: 600; color: var(--accent);">
									Leer ensayo →
								</a>
							</div>
						</article>
					))}
				</div>
			</section>
		)}

		<!-- Módulo Editorial: Debate Académico, Consultas y Correspondencia Directa -->
		<section style="margin-top: 4.5rem; padding: 2.5rem; background: #ffffff; border: 1px solid var(--border-color); border-radius: 8px; box-shadow: 0 4px 20px rgba(15, 23, 42, 0.04);">
			<div class="font-sans" style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.75rem;">
				<span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; background: #f4ede3; color: var(--accent-gold); padding: 0.2rem 0.6rem; border-radius: 4px;">
					Coloquio Editorial
				</span>
				<span style="font-size: 0.85rem; color: #94a3b8;">• Ars Cantorum</span>
			</div>

			<h3 style="font-size: 1.5rem; color: #0f172a; margin-bottom: 0.75rem;">
				Tribuna de debate académico y correspondencia
			</h3>

			<p style="font-size: 1.1rem; color: #475569; line-height: 1.7; margin-bottom: 1.8rem; font-style: italic;">
				«En Ars Cantorum concebimos la pedagogía vocal y la investigación musicológica como un diálogo riguroso y vivo. ¿Tienes alguna observación crítica sobre este ensayo, quieres consultar pasajes de los tratados canónicos o compartir experiencias de tu práctica en el aula o el escenario?»
			</p>

			<!-- Formulario Integrado Directo (Cero Fricción) -->
			<form id="form-consulta-editorial" class="font-sans" style="display: flex; flex-direction: column; gap: 1.2rem;">
				<input type="hidden" name="articulo" value={title} />
				<input type="hidden" name="_subject" value={`[Ars Cantorum] Consulta sobre: ${title}`} />
				<input type="hidden" name="_template" value="table" />
				<input type="hidden" name="_captcha" value="false" />

				<!-- Campo Honeypot invisible para humanos (trampa anti-bot silenciosa) -->
				<div style="opacity: 0; position: absolute; top: 0; left: 0; height: 0; width: 0; z-index: -1; overflow: hidden;" aria-hidden="true">
					<label for="campo-seguridad-bot">No completar este campo</label>
					<input type="text" id="campo-seguridad-bot" name="_honey" tabindex="-1" autocomplete="off" />
				</div>

				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem;">
					<div>
						<label for="autor-nombre" style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 0.35rem;">
							Tu nombre o perfil <span style="color: #94a3b8; font-weight: 400;">(ej. maestro de canto, cantante, investigador)</span>
						</label>
						<input type="text" id="autor-nombre" name="nombre" required placeholder="Nombre y apellido" 
							style="width: 100%; padding: 0.7rem 0.9rem; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.95rem; background: #f8fafc; font-family: inherit; box-sizing: border-box;" />
					</div>
					<div>
						<label for="autor-email" style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 0.35rem;">
							Tu correo electrónico <span style="color: #94a3b8; font-weight: 400;">(para responderte en privado)</span>
						</label>
						<input type="email" id="autor-email" name="email" required placeholder="correo@ejemplo.com" 
							style="width: 100%; padding: 0.7rem 0.9rem; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.95rem; background: #f8fafc; font-family: inherit; box-sizing: border-box;" />
					</div>
				</div>

				<div>
					<label for="autor-mensaje" style="display: block; font-size: 0.85rem; font-weight: 600; color: #334155; margin-bottom: 0.35rem;">
						Consulta, crítica documental o aporte pedagógico
					</label>
					<textarea id="autor-mensaje" name="mensaje" rows="4" required placeholder="Escribe aquí tus observaciones sobre las fuentes históricas, la técnica o tu experiencia en el estudio..." 
						style="width: 100%; padding: 0.75rem 0.9rem; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.95rem; background: #f8fafc; font-family: inherit; resize: vertical; line-height: 1.5; box-sizing: border-box;"></textarea>
				</div>

				<div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-top: 0.3rem;">
					<button type="submit" id="btn-enviar-consulta" 
						style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--accent); color: #ffffff; padding: 0.75rem 1.6rem; border-radius: 6px; font-weight: 600; font-size: 0.95rem; border: none; cursor: pointer; box-shadow: 0 2px 8px rgba(136, 19, 55, 0.25); transition: background-color 0.2s;">
						✉ Enviar mensaje a la redacción
					</button>

					<div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
						<span style="font-size: 0.85rem; color: #64748b; font-weight: 600;">O debatir en redes:</span>
						<a href="https://www.instagram.com/arscantorum" target="_blank" rel="noopener noreferrer" style="color: #475569; font-size: 0.85rem; font-weight: 600; text-decoration: none; border: 1px solid #e2e8f0; padding: 0.4rem 0.8rem; border-radius: 4px; background: #f8fafc;">Instagram</a>
						<a href="https://www.youtube.com/@arscantorum" target="_blank" rel="noopener noreferrer" style="color: #475569; font-size: 0.85rem; font-weight: 600; text-decoration: none; border: 1px solid #e2e8f0; padding: 0.4rem 0.8rem; border-radius: 4px; background: #f8fafc;">YouTube</a>
						<a href="https://www.facebook.com/share/1LWBuePZJt/" target="_blank" rel="noopener noreferrer" style="color: #475569; font-size: 0.85rem; font-weight: 600; text-decoration: none; border: 1px solid #e2e8f0; padding: 0.4rem 0.8rem; border-radius: 4px; background: #f8fafc;">Facebook</a>
					</div>
				</div>

				<!-- Mensaje de estado -->
				<div id="form-estado" style="display: none; padding: 1.1rem; border-radius: 6px; font-size: 0.95rem; margin-top: 0.6rem; line-height: 1.5;"></div>
			</form>
		</section>

		<!-- Pie de Artículo -->
		<div class="font-sans" style="margin-top: 4.5rem; padding-top: 2rem; border-top: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
			<a href="/" style="color: var(--accent); font-weight: 600; text-decoration: none;">
				← Volver a todos los artículos
			</a>
			<span style="color: #94a3b8; font-size: 0.85rem;">
				Ars Cantorum
			</span>
		</div>
	</div>
</Layout>

<script is:inline define:vars={{ currentSlug }}>
	document.addEventListener('DOMContentLoaded', () => {
		// Normalizar IDs de notas al pie a #fn-1 / #fnref-1 (bidireccionales con retorno ↩)
		document.querySelectorAll('.articulo-contenido [id^="user-content-fn"]').forEach(el => {
			el.id = el.id.replace(/^user-content-/, '');
		});
		document.querySelectorAll('.articulo-contenido a[href^="#user-content-fn"]').forEach(a => {
			a.setAttribute('href', (a.getAttribute('href') || '').replace(/^#user-content-/, '#'));
		});

		const STORAGE_KEY = 'arscantorum_articulos_leidos';

		function getLeidos() {
			try {
				const raw = localStorage.getItem(STORAGE_KEY);
				return raw ? JSON.parse(raw) : [];
			} catch (e) {
				return [];
			}
		}

		function guardarLeidos(lista) {
			try {
				localStorage.setItem(STORAGE_KEY, JSON.stringify(lista));
			} catch (e) {}
		}

		const btnToggle = document.getElementById('btn-toggle-leido');
		const icono = document.getElementById('icono-estado-lectura');
		const texto = document.getElementById('texto-estado-lectura');
		const subtexto = document.getElementById('subtexto-estado-lectura');
		const badgeCabecera = document.getElementById('badge-cabecera-leido');
		const centinela = document.getElementById('fin-articulo-centinela');

		function actualizarUI(esLeido) {
			if (esLeido) {
				if (icono) {
					icono.innerHTML = '✓';
					icono.style.background = '#dcfce7';
					icono.style.color = '#15803d';
					icono.style.fontWeight = '700';
				}
				if (texto) {
					texto.textContent = '✓ Ensayo completado y registrado';
					texto.style.color = '#166534';
				}
				if (subtexto) {
					subtexto.textContent = 'Guardado como leído en tu biblioteca. Continuará marcado con un check al volver al índice.';
				}
				if (btnToggle) {
					btnToggle.textContent = 'Desmarcar lectura';
					btnToggle.style.color = '#64748b';
					btnToggle.style.background = '#f8fafc';
					btnToggle.style.border = '1px solid #cbd5e1';
				}
				if (badgeCabecera) {
					badgeCabecera.style.display = 'inline-flex';
				}
			} else {
				if (icono) {
					icono.innerHTML = '📖';
					icono.style.background = '#f1f5f9';
					icono.style.color = '#64748b';
					icono.style.fontWeight = 'normal';
				}
				if (texto) {
					texto.textContent = 'Lectura en curso';
					texto.style.color = '#0f172a';
				}
				if (subtexto) {
					subtexto.textContent = 'Al llegar al final del ensayo, se registrará automáticamente como leído en tu biblioteca.';
				}
				if (btnToggle) {
					btnToggle.textContent = 'Marcar como leído';
					btnToggle.style.color = '#15803d';
					btnToggle.style.background = '#f0fdf4';
					btnToggle.style.border = '1px solid #bbf7d0';
				}
				if (badgeCabecera) {
					badgeCabecera.style.display = 'none';
				}
			}
		}

		let leidos = getLeidos();
		let estaLeido = leidos.includes(currentSlug);
		actualizarUI(estaLeido);

		// Actualizar insignias de lectura en las tarjetas de artículos relacionados
		document.querySelectorAll('[data-article-card]').forEach(card => {
			const slug = card.getAttribute('data-slug');
			if (slug && leidos.includes(slug)) {
				const badge = card.querySelector('.badge-leido');
				if (badge) badge.style.display = 'inline-flex';
				const check = card.querySelector('.check-title-leido');
				if (check) check.style.display = 'inline';
				card.style.borderLeft = '3px solid #16a34a';
			}
		});

		// Evento del botón manual
		if (btnToggle) {
			btnToggle.addEventListener('click', () => {
				leidos = getLeidos();
				if (leidos.includes(currentSlug)) {
					leidos = leidos.filter(s => s !== currentSlug);
					estaLeido = false;
				} else {
					leidos.push(currentSlug);
					estaLeido = true;
				}
				guardarLeidos(leidos);
				actualizarUI(estaLeido);
			});
		}

		// Detección automática al deslizar hasta el final del ensayo
		if (centinela && 'IntersectionObserver' in window) {
			const observer = new IntersectionObserver((entries) => {
				entries.forEach(entry => {
					if (entry.isIntersecting) {
						leidos = getLeidos();
						if (!leidos.includes(currentSlug)) {
							leidos.push(currentSlug);
							guardarLeidos(leidos);
							estaLeido = true;
							actualizarUI(true);
						}
					}
				});
			}, { threshold: 0.1 });
			observer.observe(centinela);
		}

		// Manejo del formulario de contacto editorial
		const form = document.getElementById('form-consulta-editorial');
		const btn = document.getElementById('btn-enviar-consulta');
		const estado = document.getElementById('form-estado');

		if (form && btn && estado) {
			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				btn.disabled = true;
				const textoOriginal = btn.innerHTML;
				btn.innerHTML = 'Enviando mensaje...';
				btn.style.opacity = '0.7';

				const formData = new FormData(form);
				const payload = Object.fromEntries(formData.entries());

				if (payload._honey && payload._honey.trim() !== '') {
					estado.style.display = 'block';
					estado.style.background = '#f0fdf4';
					estado.style.color = '#166534';
					estado.style.border = '1px solid #bbf7d0';
					estado.innerHTML = '<strong>✓ Mensaje enviado con éxito.</strong> Muchas gracias por tu aporte a la redacción.';
					form.reset();
					btn.innerHTML = '✓ Mensaje enviado';
					btn.style.background = '#15803d';
					btn.style.opacity = '1';
					return;
				}

				try {
					const res = await fetch('https://formsubmit.co/ajax/arscantorumoficial@gmail.com', {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json',
							'Accept': 'application/json'
						},
						body: JSON.stringify(payload)
					});

					if (res.ok) {
						estado.style.display = 'block';
						estado.style.background = '#f0fdf4';
						estado.style.color = '#166534';
						estado.style.border = '1px solid #bbf7d0';
						estado.innerHTML = '<strong>✓ Mensaje enviado con éxito.</strong> Muchas gracias por tu aporte; la redacción de <em>Ars Cantorum</em> ha recibido tu consulta y te responderá a tu correo a la brevedad.';
						form.reset();
						btn.innerHTML = '✓ Mensaje enviado';
						btn.style.background = '#15803d';
						btn.style.opacity = '1';
					} else {
						throw new Error('Error al procesar el mensaje');
					}
				} catch (err) {
					estado.style.display = 'block';
					estado.style.background = '#fef2f2';
					estado.style.color = '#991b1b';
					estado.style.border = '1px solid #fecaca';
					estado.innerHTML = 'No se pudo enviar el mensaje por un inconveniente de red. Puedes escribirnos directamente a <strong>arscantorumoficial@gmail.com</strong>.';
					btn.disabled = false;
					btn.innerHTML = textoOriginal;
					btn.style.opacity = '1';
				}
			});
		}
	});
</script>

